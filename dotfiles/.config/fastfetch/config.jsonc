{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "@HOME@/.local/share/sweet-dots/fastfetch-portrait.png",
    "width": 18,
    "height": 16,
    "preserveAspectRatio": true,
    "position": "left",
    "printRemaining": false,
    "padding": { "top": 0, "left": 1, "right": 2, "bottom": 0 }
  },
  "display": { "separator": "  " },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "────────────────────" },
    { "type": "os", "key": "󰣇 @FF_SYSTEM@", "keyColor": "cyan" },
    { "type": "kernel", "key": "󰌢 @FF_KERNEL@", "keyColor": "cyan" },
    { "type": "uptime", "key": "󰥔 @FF_UPTIME@", "keyColor": "cyan" },
    { "type": "packages", "key": "󰏖 @FF_PACKAGES@", "keyColor": "cyan" },
    { "type": "de", "key": "󰇄 @FF_SESSION@", "keyColor": "cyan" },
    { "type": "terminal", "key": "󰆍 @FF_TERMINAL@", "keyColor": "cyan" },
    { "type": "shell", "key": "󰞷 @FF_SHELL@", "keyColor": "cyan" },
    { "type": "cpu", "key": "󰍛 @FF_CPU@", "keyColor": "cyan" },
    { "type": "gpu", "key": "󰢮 @FF_GPU@", "keyColor": "cyan" },
    { "type": "memory", "key": "󰘚 @FF_MEMORY@", "keyColor": "cyan" },
    { "type": "disk", "key": "󰋊 @FF_DISK@", "keyColor": "cyan" },
    { "type": "colors", "paddingLeft": 2 }
  ]
}
