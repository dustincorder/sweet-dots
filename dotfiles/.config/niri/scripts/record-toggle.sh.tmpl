#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/1000}"
pid_file="$runtime_dir/niri-wf-recorder.pid"
videos_dir="$(xdg-user-dir VIDEOS)"
record_dir="$videos_dir/Recordings"
log_file="$runtime_dir/niri-wf-recorder.log"
mkdir -p "$record_dir"
language="$(python3 @HOME@/.config/niri/scripts/i18n.py)"

if [ -f "$pid_file" ]; then
    recorder_pid="$(sed -n '1p' "$pid_file")"
    if kill -0 "$recorder_pid" 2>/dev/null; then
        file="$(sed -n '2p' "$pid_file")"
        kill -INT "$recorder_pid"
        for _ in $(seq 1 100); do
            kill -0 "$recorder_pid" 2>/dev/null || break
            sleep 0.1
        done
        rm -f "$pid_file"
        pkill -RTMIN+8 -x waybar 2>/dev/null || true
        if ffprobe -v error -show_entries format=duration -of csv=p=0 "$file" >/dev/null 2>&1; then
            if [ "$language" = ru ]; then notify-send "Запись остановлена" "Видео сохранено: ${file/#$HOME/~}"; else notify-send "Recording stopped" "Video saved: ${file/#$HOME/~}"; fi
        elif [ "$language" = ru ]; then
            notify-send "Ошибка записи" "Видео не удалось корректно завершить. Подробности: $log_file"
        else
            notify-send "Recording failed" "Video could not be finalized. Details: $log_file"
        fi
        exit 0
    fi
    rm -f "$pid_file"
fi

mode="${1:-audio}"
scope="${2:-region}"
file="$record_dir/Recording-$(date +%F_%H-%M-%S).mp4"
audio_arg=""
if [ "$mode" != "silent" ]; then
    default_sink="$(pactl get-default-sink 2>/dev/null || true)"
    if [ -n "$default_sink" ]; then
        audio_arg="--audio=$default_sink.monitor"
    else
        audio_arg="--audio"
    fi
fi

if [ "$scope" = "region" ]; then
    # Right-click / Esc in slurp cancels. A plain left-click without a drag
    # means "just record the full screen" instead of cancelling.
    if ! geometry="$(slurp)"; then exit 0; fi
    if [ -z "$geometry" ]; then scope="full"; fi
fi
if [ "$scope" = "region" ]; then
    wf-recorder -r 30 -f "$file" $audio_arg -g "$geometry" >> "$log_file" 2>&1 &
else
    wf-recorder -r 30 -f "$file" $audio_arg >> "$log_file" 2>&1 &
fi

recorder_pid=$!
printf '%s\n' "$recorder_pid" > "$pid_file"
printf '%s\n' "$file" >> "$pid_file"
pkill -RTMIN+8 -x waybar 2>/dev/null || true
sleep 0.5
if kill -0 "$recorder_pid" 2>/dev/null; then
    if [ "$language" = ru ]; then
        notify-send "Запись началась" "Нажми ту же кнопку ещё раз, чтобы остановить."
    else
        notify-send "Recording started" "Press the same shortcut again to stop."
    fi
else
    rm -f "$pid_file"
    pkill -RTMIN+8 -x waybar 2>/dev/null || true
    if [ "$language" = ru ]; then
        notify-send "Не удалось начать запись" "Подробности: $log_file"
    else
        notify-send "Could not start recording" "Details: $log_file"
    fi
fi
