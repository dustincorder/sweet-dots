def tr(key, lang):
    value = TEXT.get(key, (key, key))
    return value[0 if lang == 'ru' else 1]


def read_settings():
    try:
        raw = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        raw = {}
    groups = raw.get('groups', DEFAULT_GROUPS)
    if not isinstance(groups, dict):
        groups = DEFAULT_GROUPS
    shortcuts = raw.get('shortcuts', [])
    if not isinstance(shortcuts, list):
        shortcuts = []
    normalized_groups = {
        side: [item for item in groups.get(side, DEFAULT_GROUPS[side]) if item != 'custom/clipboard']
        for side in ('left', 'center', 'right')
    }
    old_default = {
        'left': ['niri/workspaces'],
        'center': ['custom/clock-center'],
        'right': ['tray', 'custom/language', 'network', 'custom/bluetooth', 'pulseaudio', 'custom/power'],
    }
    temporary_single_group = {
        'left': ['niri/workspaces', 'custom/clock-center', 'tray', 'custom/language',
                 'network', 'custom/bluetooth', 'pulseaudio', 'custom/recording', 'custom/power'],
        'center': [], 'right': [],
    }
    if normalized_groups in (old_default, temporary_single_group):
        normalized_groups = {side: list(items) for side, items in DEFAULT_GROUPS.items()}
    return {
        'language': raw.get('language') if raw.get('language') in {'ru', 'en'} else 'ru',
        'workspaces': raw.get('workspaces') if raw.get('workspaces') in {2, 3, 4} else 2,
        'clock_date': bool(raw.get('clock_date', False)),
        'panel_size': raw.get('panel_size') if raw.get('panel_size') in {'small', 'medium', 'large'} else 'medium',
        'widget_size': raw.get('widget_size') if raw.get('widget_size') in {'small', 'medium', 'large'} else 'medium',
        'position': raw.get('position') if raw.get('position') in {'top', 'bottom'} else 'top',
        'groups': normalized_groups,
        'shortcuts': shortcuts,
    }


def render(template_name, prefs):
    template = TEMPLATES / template_name
    text = template.read_text()
    lang = prefs['language']
    count = int(prefs['workspaces'])
    groups = {side: list(prefs['groups'].get(side, [])) for side in ('left', 'center', 'right')}
    custom_ids = {f'custom/user-shortcut-{n}' for n in range(1, len(prefs['shortcuts']) + 1)}
    allowed = set(WIDGETS) | custom_ids
    groups = {side: [item for item in items if item in allowed] for side, items in groups.items()}
    all_items = [item for side in groups.values() for item in side]
    if len(all_items) != len(set(all_items)):
        raise ValueError('Каждый виджет можно добавить на панель только один раз.')
    for n, shortcut in enumerate(prefs['shortcuts'], 1):
        shortcut['key'] = str(shortcut.get('key', '')).strip()
        shortcut['label'] = str(shortcut.get('label', '')).strip()
        shortcut['command'] = str(shortcut.get('command', '')).strip()
        if not shortcut['label'] or not shortcut['command'] or not re.fullmatch(r'[A-Za-z0-9_+\-]+', shortcut['key']):
            raise ValueError(f'Некорректный шорткат №{n}')
    shortcut_keys = [item['key'].lower() for item in prefs['shortcuts']]
    if len(shortcut_keys) != len(set(shortcut_keys)):
        raise ValueError('Комбинации клавиш не должны повторяться.')
    definitions = []
    for n, shortcut in enumerate(prefs['shortcuts'], 1):
        module = f'custom/user-shortcut-{n}'
        display = (str(shortcut.get('icon', '')).strip() + ' ' + shortcut['label']).strip()
        definitions.append(f'{json.dumps(module)}: {{"format": {json.dumps(display, ensure_ascii=False)}, "tooltip": true, "tooltip-format": {json.dumps(shortcut["label"], ensure_ascii=False)}, "on-click": {json.dumps(shortcut["command"], ensure_ascii=False)}}}')
    keybinds = []
    for i in range(1, count + 1):
        keybinds += [f'    Mod+{i} {{ focus-workspace "{i}"; }}', f'    Mod+Shift+{i} {{ move-column-to-workspace "{i}"; }}']
    custom_keybinds = [f'    {shortcut["key"]} {{ spawn-sh {json.dumps(shortcut["command"], ensure_ascii=False)}; }}' for shortcut in prefs['shortcuts']]
    sizes = {'small': 32, 'medium': 40, 'large': 48}
    widget_sizes = {'small': (11, 25), 'medium': (13, 31), 'large': (15, 38)}
    font_size, button_size = widget_sizes[prefs['widget_size']]
    values = {
        chr(64) + 'HOME' + chr(64): str(HOME), '@WORKSPACE_DECLARATIONS@': '\n'.join(f'workspace "{i}"' for i in range(1, count + 1)),
        '@WORKSPACE_BINDS@': '\n'.join(keybinds), '@WORKSPACE_LIST@': ', '.join(json.dumps(str(i)) for i in range(1, count + 1)),
        '@CUSTOM_BINDS@': '\n'.join(custom_keybinds),
        '@MODULES_LEFT@': json.dumps(groups['left'], ensure_ascii=False), '@MODULES_CENTER@': json.dumps(groups['center'], ensure_ascii=False),
        '@MODULES_RIGHT@': json.dumps(groups['right'], ensure_ascii=False), '@USER_WIDGET_DEFS@': (',\n  '.join(definitions) + ',') if definitions else '',
        '@PANEL_POSITION@': prefs['position'], '@PANEL_HEIGHT@': str(sizes[prefs['panel_size']]),
        '@PANEL_MARGIN_TOP@': '7' if prefs['position'] == 'top' else '0',
        '@PANEL_MARGIN_BOTTOM@': '7' if prefs['position'] == 'bottom' else '0',
        '@PANEL_FONT_SIZE@': str(font_size), '@PANEL_BUTTON_SIZE@': str(button_size),
        '@UI_EMPTY@': 'Новых уведомлений нет' if lang == 'ru' else 'No new notifications',
        '@UI_NOTIFICATIONS@': 'Уведомления' if lang == 'ru' else 'Notifications', '@UI_CLEAR@': 'Очистить' if lang == 'ru' else 'Clear',
        '@UI_DND@': 'Не беспокоить' if lang == 'ru' else 'Do not disturb',
        '@UI_WIFI_LABEL@': '󰖩  Wi-Fi', '@UI_BLUETOOTH_LABEL@': '󰂯  Bluetooth',
        '@UI_NETWORK_LABEL@': '󰛳  Сеть' if lang == 'ru' else '󰛳  Network', '@UI_DEVICES_LABEL@': '󰕾  Устройства' if lang == 'ru' else '󰕾  Devices',
        '@POWER_TOOLTIP@': 'Питание · блокировка, выход, сон, перезапуск, выключение' if lang == 'ru' else 'Power · lock, log out, suspend, restart, power off',
        '@UI_LOCK@': 'Заблокировать' if lang == 'ru' else 'Lock', '@UI_LOGOUT@': 'Выйти из Niri' if lang == 'ru' else 'Log out of Niri',
        '@UI_SUSPEND@': 'Сон' if lang == 'ru' else 'Suspend', '@UI_REBOOT@': 'Перезагрузить' if lang == 'ru' else 'Restart',
        '@UI_SHUTDOWN@': 'Выключить' if lang == 'ru' else 'Power off', '@UI_APPS@': 'Приложения' if lang == 'ru' else 'Applications',
        '@UI_COMMAND@': 'Команда' if lang == 'ru' else 'Command', '@UI_CLIPBOARD@': 'Буфер обмена' if lang == 'ru' else 'Clipboard',
        '@UI_WALLPAPER@': 'Сменить обои' if lang == 'ru' else 'Change wallpaper',
        '@UI_NOTIFICATIONS_BUTTON@': 'Уведомления и быстрые настройки' if lang == 'ru' else 'Notifications and quick settings',
        '@UI_PASSWORD@': 'Пароль' if lang == 'ru' else 'Password',
        '@FF_SYSTEM@': 'система' if lang == 'ru' else 'system', '@FF_KERNEL@': 'ядро' if lang == 'ru' else 'kernel',
        '@FF_UPTIME@': 'время работы' if lang == 'ru' else 'uptime', '@FF_PACKAGES@': 'пакеты' if lang == 'ru' else 'packages',
        '@FF_SESSION@': 'сеанс' if lang == 'ru' else 'session', '@FF_TERMINAL@': 'терминал' if lang == 'ru' else 'terminal',
        '@FF_SHELL@': 'оболочка' if lang == 'ru' else 'shell', '@FF_CPU@': 'процессор' if lang == 'ru' else 'cpu',
        '@FF_GPU@': 'графика' if lang == 'ru' else 'graphics', '@FF_MEMORY@': 'память' if lang == 'ru' else 'memory',
        '@FF_DISK@': 'диск' if lang == 'ru' else 'disk',
    }
    for key, value in values.items():
        text = text.replace(key, value)
    leftover = re.findall(r'@(HOME|WORKSPACE_[A-Z_]+|PANEL_[A-Z_]+|MODULES_[A-Z_]+|USER_WIDGET_DEFS|CUSTOM_BINDS|UI_[A-Z_]+|POWER_TOOLTIP|FF_[A-Z_]+)@', text)
    if leftover:
        raise ValueError(f'Unexpanded setting in {template_name}: {leftover[0]}')
    return text


def patch_widget_scale(prefs):
    css = HOME / '.config/waybar/niri/style.css'
    if not css.exists():
        return
    font_size, button_size = {'small': (11, 25), 'medium': (13, 31), 'large': (15, 38)}[prefs['widget_size']]
    text = css.read_text()
    text, _ = re.subn(r'(^\s*font-size:\s*)\d+(px)', rf'\g<1>{font_size}\2', text, count=1, flags=re.M)
    text = re.sub(r'(#workspaces button\s*\{[^}]*?min-width:\s*)\d+px', rf'\g<1>{button_size}px', text, count=1, flags=re.S)
    power_size = {'small': 15, 'medium': 17, 'large': 20}[prefs['widget_size']]
    text = re.sub(r'(#custom-power\s*\{[^}]*?font-size:\s*)\d+px', rf'\g<1>{power_size}px', text, count=1, flags=re.S)
    text = re.sub(r'\n?/\* sweet-dots-workspace-limit \*/\n#workspaces button#niri-workspace-\d+ \{[^}]+\}\n?', '\n', text)
    transient = int(prefs['workspaces']) + 1
    text += (f'\n/* sweet-dots-workspace-limit */\n'
             f'#workspaces button#niri-workspace-{transient} '
             '{ min-width: 0; padding: 0; margin: 0; opacity: 0; }\n')
    css.write_text(text)


def apply(prefs):
    prefs = dict(prefs)
    prefs.setdefault('groups', DEFAULT_GROUPS)
    prefs.setdefault('shortcuts', [])
    prefs.setdefault('panel_size', 'medium')
    prefs.setdefault('widget_size', 'medium')
    prefs.setdefault('position', 'top')
    prefs.setdefault('clock_date', False)
    if prefs.get('language') not in {'ru', 'en'} or prefs.get('workspaces') not in {2, 3, 4}:
        raise ValueError('Проверь язык и количество рабочих мест.')
    rendered = {name: render(name, prefs) for name in TARGETS}
    SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS.write_text(json.dumps(prefs, ensure_ascii=False, indent=2) + '\n')
    stamp = time.strftime('%Y%m%d-%H%M%S')
    backup = HOME / '.local/state/sweet-dots/settings-backups' / stamp
    for template_name, target in TARGETS.items():
        content = rendered[template_name]
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists():
            backup_target = backup / target.relative_to(HOME)
            backup_target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, backup_target)
        temporary = target.with_suffix(target.suffix + '.tmp')
        temporary.write_text(content)
        temporary.replace(target)
    update_rofi_labels(prefs['language'])
    patch_widget_scale(prefs)
    subprocess.run(['niri', 'msg', 'action', 'load-config-file'], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    reloaded = subprocess.run(['pkill', '-USR2', '-x', 'waybar'], check=False,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if reloaded.returncode != 0:
        subprocess.Popen(['waybar', '-c', str(HOME / '.config/waybar/niri/config.jsonc'),
                          '-s', str(HOME / '.config/waybar/niri/style.css')],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    subprocess.run(['swaync-client', '--reload-config'], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['swaync-client', '--reload-css'], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return prefs


def update_rofi_labels(lang):
    for path in (HOME / '.config/rofi/themes/niri.rasi', HOME / '.config/rofi/themes/niri.template.rasi'):
        if not path.exists():
            continue
        text = path.read_text()
        apps = 'Приложения' if lang == 'ru' else 'Applications'
        command = 'Команда' if lang == 'ru' else 'Command'
        text = re.sub(r'display-drun:\s*"[^"]*";', f'display-drun: "{apps}";', text)
        text = re.sub(r'display-run:\s*"[^"]*";', f'display-run: "{command}";', text)
        path.write_text(text)


def cli_setup(args):
    current = read_settings()
    current.update({'language': args.language, 'workspaces': args.workspaces, 'panel_size': args.panel_size,
                    'widget_size': args.widget_size, 'position': args.position})
    apply(current)
    print('Sweet Dots settings saved.')


