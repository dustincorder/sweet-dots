        for key, names in WIDGETS.items():
            if key not in used:
                available.insert('end', f'{key}  ·  {names[0 if lang.get() == "ru" else 1]}')
        for index, shortcut in enumerate(shortcut_values, 1):
            key = f'custom/user-shortcut-{index}'
            if key not in used:
                available.insert('end', f'{key}  ·  {shortcut.get("label", "")}')
        for side in groups:
            listbox = groups[side]
            listbox.delete(0, 'end')
            for widget in current[side]:
                label = next((f'{widget}  ·  {s[0 if lang.get() == "ru" else 1]}' for key, s in WIDGETS.items() if key == widget), widget)
                if widget.startswith('custom/user-shortcut-'):
                    idx = int(widget.rsplit('-', 1)[-1]) - 1
                    if idx < len(shortcut_values):
                        label = f'{widget}  ·  {shortcut_values[idx].get("label", "")}'
                listbox.insert('end', label)
    def add_widget():
        key = selected_available()
        if key:
            selected_side = next((side for side in groups if destination.get() in {side, tr(side, lang.get())}), 'right')
            groups[selected_side].insert('end', key)
            refresh_widgets()
    add_widget_button.configure(command=add_widget)
    move_buttons = {}
    for col, side in enumerate(active_lists, 1):
        row = ttk.Frame(dock)
        row.grid(row=4, column=col, sticky='ew', padx=5)
        def remove(side=side):
            box = groups[side]
            sel = box.curselection()
            if sel:
                box.delete(sel[0])
                refresh_widgets()
        def move(side=side, delta=-1):
            box = groups[side]
            sel = box.curselection()
            if not sel:
                return
            i, j = sel[0], max(0, min(box.size() - 1, sel[0] + delta))
            item = box.get(i).split('  ·  ')[0]
            box.delete(i)
            box.insert(j, item)
            box.selection_set(j)
            refresh_widgets()
        up_button = ttk.Button(row, command=lambda side=side: move(side, -1))
        down_button = ttk.Button(row, command=lambda side=side: move(side, 1))
        remove_button = ttk.Button(row, command=remove)
        up_button.pack(side='left', padx=(0, 3)); down_button.pack(side='left', padx=3); remove_button.pack(side='left', padx=3)
        move_buttons[side] = (up_button, down_button, remove_button)
    shortcut_values = [dict(s) for s in prefs['shortcuts']]
    for side in groups:
        for widget in prefs['groups'].get(side, []):
            groups[side].insert('end', widget)
    shortcut_list = tk.Listbox(shortcuts_tab, height=12, exportselection=False, bg='#101820', fg='#e4edf2', selectbackground='#254653', borderwidth=0, highlightthickness=1, highlightbackground='#32444c')
    shortcut_list.pack(fill='both', expand=True, pady=(8, 10))
    def refresh_shortcuts():
        shortcut_list.delete(0, 'end')
        for item in shortcut_values:
            shortcut_list.insert('end', f'{item.get("key", "")}  ·  {item.get("label", "")}  →  {item.get("command", "")}')
    def shortcut_editor(item=None):
        source = item or {'key': '', 'label': '', 'command': '', 'icon': '󰌌'}
        dialog = tk.Toplevel(root)
        dialog.title(tr('edit' if item else 'new', lang.get()))
        dialog.configure(bg='#101820')
        fields = {}
        for row, key in enumerate(('label', 'key', 'command', 'icon')):
            ttk.Label(dialog, text=tr(key, lang.get())).grid(row=row, column=0, sticky='w', padx=12, pady=7)
            fields[key] = tk.StringVar(value=source.get(key, ''))
            ttk.Entry(dialog, textvariable=fields[key], width=42).grid(row=row, column=1, padx=12, pady=7)
        def accept():
            value = {key: var.get().strip() for key, var in fields.items()}
            if not value['label'] or not value['command'] or not re.fullmatch(r'[A-Za-z0-9_+\-]+', value['key']):
                messagebox.showerror(tr('error', lang.get()), tr('invalid', lang.get()), parent=dialog)
                return
            if item is None:
                shortcut_values.append(value)
                # Newly added shortcut is placed at the end of the right side.
                groups['right'].insert('end', f'custom/user-shortcut-{len(shortcut_values)}')
            else:
                item.update(value)
            refresh_shortcuts()
            refresh_widgets()
            dialog.destroy()
        ttk.Button(dialog, text=tr('apply', lang.get()), command=accept).grid(row=4, column=1, sticky='e', padx=12, pady=12)
    shortcut_buttons = ttk.Frame(shortcuts_tab)
    shortcut_buttons.pack(anchor='e')
    new_button = ttk.Button(shortcut_buttons, command=lambda: shortcut_editor())
    new_button.pack(side='left', padx=4)
    edit_button = ttk.Button(shortcut_buttons)
    edit_button.pack(side='left', padx=4)
    delete_button = ttk.Button(shortcut_buttons)
    delete_button.pack(side='left', padx=4)
    def edit_selected():
        sel = shortcut_list.curselection()
        if sel:
            shortcut_editor(shortcut_values[sel[0]])
    def delete_selected():
        sel = shortcut_list.curselection()
        if not sel:
            return
        index = sel[0]
        shortcut_values.pop(index)
        for side in groups:
            old = [groups[side].get(n).split('  ·  ')[0] for n in range(groups[side].size())]
            groups[side].delete(0, 'end')
            for item in old:
                match = re.fullmatch(r'custom/user-shortcut-(\d+)', item)
                if match:
                    number = int(match.group(1))
                    if number == index + 1:
                        continue
                    if number > index + 1:
                        item = f'custom/user-shortcut-{number - 1}'
                groups[side].insert('end', item)
        refresh_shortcuts()
    edit_button.configure(command=edit_selected)
    delete_button.configure(command=delete_selected)
    footer = ttk.Frame(content)
    footer.pack(fill='x', pady=(12, 0))
    apply_button = ttk.Button(footer, command=lambda: None)
    apply_button.pack(side='right')

    def refresh_labels(*_):
        current = lang.get()
        root.title(tr('name', current)); heading.configure(text=tr('name', current))
        notebook.tab(general, text=tr('general', current)); notebook.tab(dock, text=tr('dock', current)); notebook.tab(shortcuts_tab, text=tr('shortcuts', current))
        language_label.configure(text=tr('language', current)); workspace_label.configure(text=tr('workspaces', current))
        position_label.configure(text=tr('position', current)); height_label.configure(text=tr('height', current)); widget_size_label.configure(text=tr('widget_size', current))
        position_combo.configure(values=(tr('top', current), tr('bottom', current)), state='readonly')
        position_combo.set(tr(selected_values['position'], current))
        height_combo.configure(values=tuple(tr(k, current) for k in ('small', 'medium', 'large')))
        widget_size_combo.configure(values=tuple(tr(k, current) for k in ('small', 'medium', 'large')))
        height_combo.set(tr(selected_values['panel_size'], current)); widget_size_combo.set(tr(selected_values['widget_size'], current))
        date_check.configure(text=tr('clock_date', current)); hint.configure(text=tr('hint', current))
        available_label.configure(text=tr('available', current)); add_widget_button.configure(text=tr('add', current))
        for side, label in group_labels.items(): label.configure(text=tr(side, current))
        current_side = next((side for side in groups if destination.get() in {side, tr(side, current)}), 'right')
        destination_combo.configure(values=tuple(tr(s, current) for s in ('left', 'center', 'right')))
        destination_combo.set(tr(current_side, current))
        for side, buttons in move_buttons.items():
            buttons[0].configure(text=tr('up', current)); buttons[1].configure(text=tr('down', current)); buttons[2].configure(text=tr('remove', current))
        new_button.configure(text=tr('new', current)); edit_button.configure(text=tr('edit', current)); delete_button.configure(text=tr('delete', current))
        apply_button.configure(text=tr('apply', current))
        refresh_widgets(); refresh_shortcuts()

    def save():
        current = lang.get()
        target_side = destination.get()
        try:
            groups_value = {side: [item.split('  ·  ')[0] for item in groups[side].get(0, 'end')] for side in groups}
            panel_size_value = selected_values['panel_size']
            widget_size_value = selected_values['widget_size']
            position_value = selected_values['position']
            apply({'language': current, 'workspaces': int(workspace_var.get()), 'clock_date': variables['clock_date'].get(),
                   'panel_size': panel_size_value, 'widget_size': widget_size_value, 'position': position_value,
                   'groups': groups_value, 'shortcuts': shortcut_values})
        except Exception as exc:
            messagebox.showerror(tr('error', current), str(exc), parent=root)
            return
        messagebox.showinfo(tr('saved', current), tr('ok', current), parent=root)

    apply_button.configure(command=save)
    lang.trace_add('write', refresh_labels)
    refresh_labels()
    # Convert visible translated combobox labels to internal values before saving.
    root.mainloop()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--setup', action='store_true')
    parser.add_argument('--language', choices=('ru', 'en'), default='ru')
    parser.add_argument('--workspaces', type=int, choices=(2, 3, 4), default=2)
    parser.add_argument('--panel-size', choices=('small', 'medium', 'large'), default='medium')
    parser.add_argument('--widget-size', choices=('small', 'medium', 'large'), default='medium')
    parser.add_argument('--position', choices=('top', 'bottom'), default='top')
    parser.add_argument('--refresh-style', action='store_true')
    args = parser.parse_args()
    if args.refresh_style:
        patch_widget_scale(read_settings())
    elif args.setup:
        prefs = read_settings()
        prefs.update({'language': args.language, 'workspaces': args.workspaces, 'panel_size': args.panel_size,
                      'widget_size': args.widget_size, 'position': args.position})
        apply(prefs)
    else:
        gui()


if __name__ == '__main__':
    main()
