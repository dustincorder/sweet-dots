#!/usr/bin/env python3
"""Start one supervised Waybar per user; preserve diagnostics after reloads."""
import fcntl
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

HOME = Path.home()


def running():
    result = subprocess.run(['pgrep', '-u', str(os.getuid()), '-x', 'waybar'],
                            capture_output=True, text=True, check=False)
    return [int(pid) for pid in result.stdout.split()]


def supervise():
    state = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state')) / 'sweet-dots'
    state.mkdir(parents=True, exist_ok=True)
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', state))
    with (runtime / 'sweet-dots-waybar.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        # Applets are presentation processes, not NetworkManager/BlueZ services.
        # Restrict cleanup to the current user's Niri session.
        if os.environ.get('NIRI_SOCKET'):
            for applet in ('nm-applet', 'blueman-applet', 'blueman-tray'):
                subprocess.run(['pkill', '-u', str(os.getuid()), '-x', applet], check=False)
        # An existing unsupervised panel is adopted without killing it.
        while running():
            time.sleep(1)
        failures = 0
        with (state / 'waybar.log').open('a', buffering=1) as log:
            while failures < 3:
                log.write(time.strftime('\n[%Y-%m-%d %H:%M:%S] Starting Waybar\n'))
                started = time.monotonic()
                try:
                    result = subprocess.run([
                        'waybar', '-c', str(HOME / '.config/waybar/niri/config.jsonc'),
                        '-s', str(HOME / '.config/waybar/niri/style.css'),
                    ], stdout=log, stderr=log, check=False)
                except OSError as exc:
                    log.write(f'{exc}\n')
                    return
                log.write(f'Waybar exited: {result.returncode}\n')
                failures = 1 if time.monotonic() - started > 30 else failures + 1
                time.sleep(failures)
            log.write('Stopped after three rapid failures; inspect config and CSS.\n')


def main():
    if '--supervise' in sys.argv:
        supervise()
        return
    if '--reload' in sys.argv:
        for pid in running():
            try:
                os.kill(pid, signal.SIGUSR2)
            except ProcessLookupError:
                pass
    # flock in the detached supervisor prevents duplicate starts, including
    # concurrent startup/wallpaper/settings calls. It also recovers a reload crash.
    subprocess.Popen([sys.executable, str(Path(__file__)), '--supervise'],
                     start_new_session=True, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL)


if __name__ == '__main__':
    main()
