#!/usr/bin/env bash
set -euo pipefail

layout=$(niri msg keyboard-layouts | sed -n 's/^[[:space:]]*\*[[:space:]]*[0-9][0-9]*[[:space:]]*//p' | head -n1)
case "$layout" in
    *English*|*US*) label="EN" ;;
    *Russian*|*рус*) label="RU" ;;
    *) label="?" ;;
esac
language="$(python3 @HOME@/.config/niri/scripts/i18n.py)"
if [ "$language" = ru ]; then
    hint="Раскладка: $layout · Shift+Alt переключает"
else
    hint="Keyboard: $layout · Shift+Alt switches"
fi
printf '{"text":"%s","tooltip":"%s"}\n' "$label" "$hint"
