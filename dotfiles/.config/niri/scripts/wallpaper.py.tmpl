#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys
import tomllib

from i18n import WALLPAPERS as WALLPAPER_LABELS, language, tr

HOME = Path.home()
WALLPAPER_DIR = HOME / '.local/share/niri/wallpapers'
CURRENT = WALLPAPER_DIR / 'current.jpg'
THEME = HOME / '.config/matugen/config.toml'
ROFI_THEME = HOME / '.config/rofi/themes/niri.rasi'
SUPPORTED = {'.png', '.jpg', '.jpeg', '.webp', '.avif'}


def available_wallpapers():
    WALLPAPER_DIR.mkdir(parents=True, exist_ok=True)
    images = [p for p in WALLPAPER_DIR.iterdir()
              if p.is_file() and p.suffix.lower() in SUPPORTED
              and p.stem != 'current' and not p.stem.endswith('-thumb')]
    lang = language()
    return [(WALLPAPER_LABELS.get(p.stem, {}).get(lang, p.stem.replace('_', ' ').replace('-', ' · ').title()), p)
            for p in sorted(images, key=lambda path: path.name.casefold())]


def update_fastfetch_portrait(image):
    helper = HOME / '.config/niri/scripts/prepare-fastfetch-logo.py'
    subprocess.run(['python3', str(helper), str(image)], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def select_wallpaper(choices):
    rows = []
    for label, image in choices:
        thumb = WALLPAPER_DIR / (image.stem + '-thumb.png')
        if not thumb.exists():
            subprocess.run(['magick', str(image), '-resize', '180x100^', '-gravity', 'center',
                            '-extent', '180x100', str(thumb)], check=False)
        rows.append(f'{label}\0icon\x1f{thumb}')
    result = subprocess.run([
        'rofi', '-dmenu', '-i', '-show-icons', '-p', tr('wallpaper_prompt'), '-theme', str(ROFI_THEME),
        '-no-lazy-grab', '-kb-cancel', 'Escape,Control+g',
        '-kb-accept-entry', 'Return,KP_Enter',
    ], input='\n'.join(rows), text=True, capture_output=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    selected = result.stdout.split('\0', 1)[0].strip()
    return next((image for label, image in choices if label == selected), None)


def apply_wallpaper(image):
    if not image.is_file():
        raise FileNotFoundError(f'{tr("wallpaper_missing")}: {image}')
    # Matugen can write some outputs before a later template fails. Keep the
    # complete old palette so a partial failure never reaches running apps.
    config = tomllib.loads(THEME.read_text())
    outputs = [Path(entry['output_path']).expanduser() for entry in config['templates'].values()]
    previous = {path: path.read_bytes() if path.exists() else None for path in outputs}
    try:
        result = subprocess.run([
            'matugen', 'image', str(image), '--config', str(THEME), '--mode', 'dark',
            '--type', 'scheme-content', '--source-color-index', '0', '--quiet',
        ], check=False, capture_output=True, text=True)
        if result.returncode:
            raise RuntimeError((result.stderr or result.stdout).strip()[-500:])
        subprocess.run(['awww', 'img', '--transition-type', 'fade', '--transition-duration', '0.45', str(image)], check=True)
    except (OSError, RuntimeError, subprocess.CalledProcessError) as exc:
        for path, data in previous.items():
            if data is None:
                path.unlink(missing_ok=True)
            else:
                temporary = path.with_suffix(path.suffix + '.rollback')
                temporary.write_bytes(data)
                temporary.replace(path)
        subprocess.run(['notify-send', tr('theme_failed'), str(exc)], check=False)
        return False
    temporary = CURRENT.with_name('.current-next.jpg')
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(image.resolve())
    temporary.replace(CURRENT)
    update_fastfetch_portrait(image)
    subprocess.run(['python3', str(HOME / '.config/niri/scripts/settings.py'), '--refresh-style'], check=False)
    subprocess.run(['niri', 'msg', 'action', 'load-config-file'], check=False)
    subprocess.run(['swaync-client', '--reload-css'], check=False)
    subprocess.run(['python3', str(HOME / '.config/niri/scripts/panel.py'), '--reload'], check=False)
    return True


def main():
    choices = available_wallpapers()
    image = (CURRENT.resolve() if CURRENT.exists() else (choices[0][1] if choices else None)) if '--apply-current' in sys.argv else select_wallpaper(choices)
    if image is not None:
        return 0 if apply_wallpaper(image) else 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
