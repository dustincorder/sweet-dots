#!/usr/bin/env python3
"""Render the character matching the selected Sweet Pool wallpaper for Fastfetch."""
from pathlib import Path
import os
import subprocess
import sys

HOME = Path.home()
CG = Path(os.environ.get('SWEET_POOL_CG_DIR', '/mnt/disk/sweet pool/assets/cg'))
WALLPAPER = Path(sys.argv[1]) if len(sys.argv) > 1 else None
OUTPUT = HOME / '.local/share/sweet-dots'
PERSONAS = {
    'yoji': '蓉司',
    'aquarium': '蓉司',
    'makoto': '睦',
    'tetsuo': '哲雄',
    'zenya': '善弥',
}


def selected_character():
    stem = WALLPAPER.stem.lower() if WALLPAPER else ''
    for prefix, name in PERSONAS.items():
        if prefix in stem:
            return name
    return '蓉司'


def main():
    OUTPUT.mkdir(parents=True, exist_ok=True)
    character = selected_character()
    source = CG / 'st' / f'st{character}_制服_normal.png'
    if not source.is_file():
        return
    png = OUTPUT / 'fastfetch-portrait.png'
    subprocess.run([
        'magick', str(source), '-trim', '+repage', '-resize', '550x640>',
        '-background', '#101820', '-gravity', 'center', '-extent', '550x640',
        str(png),
    ], check=True)


if __name__ == '__main__':
    main()
