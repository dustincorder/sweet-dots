def language():
    try:
        value = json.loads(SETTINGS.read_text()).get('language', 'ru')
    except (OSError, ValueError, AttributeError):
        value = 'ru'
    return value if value in {'ru', 'en'} else 'ru'


def tr(key, lang=None):
    return TEXT.get(key, {}).get(lang or language(), key)


if __name__ == '__main__':
    locale = sys.argv[1] if len(sys.argv) > 1 else language()
    key = sys.argv[2] if len(sys.argv) > 2 else ''
    print(tr(key, locale))
