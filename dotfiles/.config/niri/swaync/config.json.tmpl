{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-positionX": "center",
  "control-center-positionY": "@PANEL_POSITION@",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-width": 420,
  "control-center-height": -1,
  "fit-to-screen": false,
  "control-center-margin-top": @OVERLAY_MARGIN_TOP@,
  "control-center-margin-bottom": @OVERLAY_MARGIN_BOTTOM@,
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "control-center-exclusive-zone": false,
  "notification-window-width": 350,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 340,
  "hide-on-clear": true,
  "hide-on-action": true,
  "relative-timestamps": true,
  "text-empty": "@UI_EMPTY@",
  "widgets": [
    "mpris",
    "calendar",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "@UI_NOTIFICATIONS@",
      "clear-all-button": true,
      "button-text": "@UI_CLEAR@"
    },
    "mpris": {
      "show-album-art": "always"
    },
    "calendar": {"show-day-label": true, "show-date-label": true}
  }
}
