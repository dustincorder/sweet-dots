{
  "layer": "top",
  "position": "@PANEL_POSITION@",
  "height": @PANEL_HEIGHT@,
  "margin-top": @PANEL_MARGIN_TOP@,
  "margin-bottom": @PANEL_MARGIN_BOTTOM@,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 5,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "modules-left": @MODULES_LEFT@,
  "modules-center": @MODULES_CENTER@,
  "modules-right": @MODULES_RIGHT@,
  @USER_WIDGET_DEFS@

  @WORKSPACE_WIDGET_DEFS@

  "niri/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true
  },
  "cpu": {
    "interval": 5,
    "format": "󰘚 {usage}%",
    "tooltip": true
  },
  "memory": {
    "interval": 10,
    "format": "󰍛 {percentage}%",
    "tooltip": true
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "python3 @HOME@/.config/niri/scripts/applets.py network",
    "on-click-right": "nm-connection-editor"
  },
  "custom/bluetooth": {
    "exec": "@HOME@/.config/niri/scripts/bluetooth-status.sh",
    "return-type": "json",
    "interval": 8,
    "on-click": "python3 @HOME@/.config/niri/scripts/applets.py bluetooth",
    "on-click-right": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {"default": ["󰕿", "󰖀", "󰕾"]},
    "on-click": "python3 @HOME@/.config/niri/scripts/applets.py audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "pavucontrol",
    "scroll-step": 5
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": false
  },
  "custom/notifications": {
    "format": "󰂚",
    "tooltip": true,
    "tooltip-format": "@UI_NOTIFICATIONS_BUTTON@",
    "on-click": "@HOME@/.config/niri/scripts/toggle-notifications.sh"
  },
  "custom/wallpaper": {
    "format": "󰸉",
    "tooltip": true,
    "tooltip-format": "@UI_WALLPAPER@",
    "on-click": "python3 @HOME@/.config/niri/scripts/wallpaper.py"
  },
  "custom/media": {
    "exec": "python3 @HOME@/.config/niri/scripts/media-status.py",
    "return-type": "json",
    "interval": 3,
    "max-length": 26,
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },
  "custom/language": {
    "exec": "@HOME@/.config/niri/scripts/keyboard-layout.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "niri msg action switch-layout next"
  },
  "custom/recording": {
    "exec": "@HOME@/.config/niri/scripts/recording-status.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "tooltip": true,
    "on-click": "@HOME@/.config/niri/scripts/record-toggle.sh"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "@POWER_TOOLTIP@",
    "on-click": "wlogout --protocol layer-shell --layout @HOME@/.config/wlogout/layout --css @HOME@/.config/wlogout/style.css --buttons-per-row 3 --column-spacing 12 --row-spacing 12 --margin 24"
  },
  "custom/clock-center": {
    "exec": "python3 @HOME@/.config/niri/scripts/clock.py",
    "return-type": "json",
    "interval": 15,
    "tooltip": true,
    "on-click": "@HOME@/.config/niri/scripts/toggle-notifications.sh"
  }
}
