* {
  border: none;
  border-radius: 0;
  font-family: "SF Pro Display", "Inter", "Noto Sans", "Symbols Nerd Font";
  font-size: 13px;
  min-height: 0;
}
window#waybar { background: transparent; color: {{colors.on_surface.dark.hex}}; }
window#waybar > box {
  background-color: {{colors.surface.dark.hex}};
  border: 1px solid {{colors.outline_variant.dark.hex}};
  border-radius: 16px;
  background-clip: padding-box;
  padding: 0 8px;
}
#workspaces, #custom-clock-center, #tray, #network, #custom-bluetooth,
#custom-language, #pulseaudio, #custom-recording, #custom-power, #cpu, #memory,
#custom-media, .modules-left, .modules-center, .modules-right {
  margin: 3px 2px;
}
#workspaces {
  background: {{colors.surface_container.dark.hex}};
  border-radius: 11px;
  padding: 2px;
}
#workspaces button {
  background: transparent;
  border-radius: 9px;
  color: {{colors.on_surface_variant.dark.hex}};
  min-width: 31px;
  padding: 0 8px;
  transition: background 180ms ease, color 180ms ease;
}
#workspaces button:hover { background: {{colors.surface_container_high.dark.hex}}; color: {{colors.on_surface.dark.hex}}; }
#workspaces button.active { background: {{colors.primary_container.dark.hex}}; color: {{colors.on_primary_container.dark.hex}}; }
#workspaces button.empty { color: {{colors.outline.dark.hex}}; }
#custom-clock-center { color: {{colors.on_surface.dark.hex}}; padding: 0 10px; }
#tray { padding: 0 5px; }
#network, #custom-bluetooth, #custom-language, #pulseaudio,
#custom-recording, #custom-power, #cpu, #memory, #custom-media {
  color: {{colors.on_surface.dark.hex}};
  padding: 0 7px;
}
#custom-power {
  background: {{colors.surface_container.dark.hex}};
  border: 1px solid {{colors.outline_variant.dark.hex}};
  border-radius: 9px;
  min-width: 31px;
}
#custom-language { min-width: 0; padding: 0 4px; }
#network, #custom-bluetooth, #pulseaudio { font-size: 16px; }
#custom-power { font-size: 17px; }
#custom-recording { color: {{colors.error.dark.hex}}; font-weight: bold; }
.modules-left, .modules-center, .modules-right { padding: 0 6px; }
.modules-right > widget:nth-child(2), .modules-right > widget:nth-child(5),
.modules-right > widget:last-child { margin-left: 9px; }
#network:hover, #custom-bluetooth:hover, #custom-language:hover,
#pulseaudio:hover, #custom-power:hover {
  background: {{colors.surface_container_high.dark.hex}};
  color: {{colors.on_surface.dark.hex}};
}
tooltip {
  background: {{colors.surface_container_high.dark.hex}};
  border: 1px solid {{colors.outline_variant.dark.hex}};
  border-radius: 10px;
  color: {{colors.on_surface.dark.hex}};
  padding: 7px 9px;
}
